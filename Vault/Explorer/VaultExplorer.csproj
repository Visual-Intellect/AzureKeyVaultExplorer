<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Microsoft.Vault.Explorer</RootNamespace>
    <AssemblyName>VaultExplorer</AssemblyName>
    <Description>Azure Key Vault Explorer</Description>
    <ApplicationIcon>VaultExplorer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.ResourceManager.KeyVault" Version="1.5.0" />
    <PackageReference Include="Scintilla5.NET" Version="7.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClearClipboard\ClearClipboard.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Library\VaultLibrary.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="VaultExplorer.ico;VaultExplorer.png;License.txt;CustomTags.json;VaultAliases.json;SecretKinds.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Vaults.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>